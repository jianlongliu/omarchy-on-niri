[Unit]
Description=Lock Omarchy before suspend
# The monitor calls into the running Omarchy shell, so it must start with the
# session. Keeps the default target ordering (no Before=) deliberately.
After=dbus.socket
Requires=dbus.socket
PartOf=graphical-session.target
# Upstream ships two ConditionEnvironment= lines here; both had to go.
#  * OMARCHY_PATH can never pass on this machine: ConditionEnvironment reads the
#    *user manager's* environment, never the unit's own Environment= (probe unit,
#    2026-09-21), and nothing imports OMARCHY_PATH here because there is no UWSM.
#    It is set under [Service] instead.
#  * WAYLAND_DISPLAY looked satisfiable -- niri does export it -- but not yet at
#    the moment this unit is evaluated: graphical-session.target is reached ~1s
#    before the session publishes its environment (boot of 2026-09-21: unit
#    skipped 20:10:17, niri up 20:10:18), so the unit was silently dead and
#    closing the lid suspended without locking. The monitor needs the session
#    environment anyway, so the wait moved into omarchy-sleep-lock-start.

[Service]
Type=simple
# %h rather than a literal path: the unit lives in the repo as a template.
Environment=OMARCHY_PATH=%h/.local/share/omarchy
# ~/bin first: the port's hyprctl shim lives there and omarchy-system-sleep-lock
# reaches it through omarchy-hyprland-monitor-clamshell. $OMARCHY_PATH/bin is
# needed because that script calls bare `omarchy-shell` for the lock IPC.
Environment=PATH=%h/bin:%h/.local/share/omarchy/bin:/usr/local/bin:/usr/bin
# Waits for the session environment, then execs the upstream monitor.
ExecStart=%h/bin/omarchy-sleep-lock-start
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
