#!/bin/bash
# omarchy-update — 手装（dev-link）机器专用垫片。正本：port-bin/omarchy-update
#
# 为什么换掉上游脚本：这类机器没装 omarchy 包、没配 Omarchy 自家仓库 —— 上游流程会卡在
# omarchy-update-keyring（omarchy-keyring 装不到，set -e 直接终止），后面还用 yay
# （这类机器上通常是 paru），中间却会执行无人值守的 `pacman -Syu --noconfirm`。
#
# 谁落到这里：
#   * omarchy menu 的 Update → System、bar 的 system-update 部件（裸调 `omarchy-update`，
#     ~/bin 在 PATH 里排在 $OMARCHY_PATH/bin 之前）
#   * CLI `omarchy update` —— dispatcher 走绝对路径 $OMARCHY_PATH/bin/omarchy-update，
#     那份文件顶部有三行委派（见 docs/local-overrides.md §8 第 19 项）
#
# 本垫片 = 四段：pacman -Syu → AUR（优先 paru，`-Sua` 只做 AUR）→ omarchy plugin update → mise up。
# `omarchy-update aur` 只跑 AUR 那一段（菜单 Update → AUR Packages 走的也是这条）。
# 想跑上游那套（代码 FF、migrate、snapshot、prune、孤儿包清理、keyring）：--upstream。
#
# 回退：rm ~/bin/omarchy-update；CLI 那条还要还原 checkout 里那份（见 §9 回退索引）。

set -euo pipefail

omarchy_path=${OMARCHY_PATH:-$HOME/.local/share/omarchy}

usage() {
  cat <<'EOF'
omarchy-update（本机垫片）

  omarchy-update              系统包 + AUR + omarchy 插件 + mise 工具
  omarchy-update aur          只更 AUR 包（= paru -Sua；菜单 Update → AUR Packages 也走这条）
  omarchy-update --upstream   跑上游 omarchy-update 真身（代码 FF、迁移、keyring 那套）
  omarchy-update -h|--help    这份说明

不含上游的：代码 FF（git pull）、omarchy-migrate、snapshot、pkg-prune、孤儿包清理、keyring。
上游代码跟进走 docs/upstream.md 的手动路径（git pull → omarchy-niri-repatch → omarchy-restart-shell）。
EOF
}

aur_only=0
case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
--upstream)
  # 逃生口：真身认得这个 env 才不往回委派（防递归）。
  exec env OMARCHY_UPDATE_NO_DELEGATE=1 "$omarchy_path/bin/omarchy-update" "${@:2}"
  ;;
aur)
  # CLI `omarchy update aur` = 只更 AUR（dispatcher 只匹配到 update，把 aur 当残留参数传进来）。
  aur_only=1
  ref=${2:-}
  if [[ -n $ref ]]; then
    echo "omarchy-update: aur 后面不接参数（收到 '$ref'）" >&2
    exit 2
  fi
  ;;
"") ;;
*)
  echo "omarchy-update: 未知参数 '$1'（-h 看用法；上游那套用 --upstream）" >&2
  exit 2
  ;;
esac

# AUR 段 = **只做 AUR**：`-Sua`（`-a` = `--aur`，本机 help 原话 "Assume targets are from the AUR"）。
# repo 那半边由 `pacman -Syu` 负责，所以 `-Su`（不带 a）是错的用法 —— 它会连 repo 再做一遍。
# 优先 paru，且先确认它真的可执行；返回 1 表示没有可用的 helper。
aur_segment() {
  local candidate helper_path
  for candidate in paru yay; do
    helper_path=$(command -v "$candidate" 2>/dev/null) || continue
    if [[ -x $helper_path ]]; then
      if pacman -Qem >/dev/null 2>&1; then
        echo -e "\e[32m\nAUR packages ($helper_path -Sua)\e[0m"
        "$helper_path" -Sua
      else
        echo -e "\e[33m\n没有外部（AUR）包，跳过\e[0m"
      fi
      return 0
    fi
  done
  echo -e "\e[33m\n没找到可执行的 AUR helper（paru/yay），跳过 AUR\e[0m"
  return 1
}

if [[ $aur_only == 1 ]]; then
  aur_segment || exit 1
  exit 0
fi

echo -e "\e[32m\nSystem packages (pacman -Syu)\e[0m"
sudo pacman -Syu

aur_segment || true

if [[ -x $omarchy_path/bin/omarchy ]]; then
  echo -e "\e[32m\nOmarchy plugins\e[0m"
  "$omarchy_path/bin/omarchy" plugin update
fi

if command -v mise >/dev/null 2>&1; then
  echo -e "\e[32m\nmise tools\e[0m"
  MISE_MINIMUM_RELEASE_AGE=0 mise up
fi
