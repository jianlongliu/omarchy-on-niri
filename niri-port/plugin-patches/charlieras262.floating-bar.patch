-      opacity: root.transparent ? 1 : Style.shellOpacity
+      // it turns blur on/off -- blur only renders behind a surface that isn't
+      // fully opaque. Only applies when the background is actually drawn:
+      // `transparent` already means "nothing to see here" and takes priority.
+      // niri port: this Omarchy version has no shellOpacity token, so fall
+      // back to fully opaque instead of assigning undefined to a double.
+      opacity: root.transparent ? 1
+        : (typeof Style.shellOpacity === "number" ? Style.shellOpacity : 1)
       Behavior on radius { NumberAnimation { duration: 420; easing.type: Easing.InOutCubic } }
       Behavior on color { ColorAnimation { duration: 420; easing.type: Easing.InOutCubic } }
       Behavior on opacity { NumberAnimation { duration: 420; easing.type: Easing.InOutCubic } }
