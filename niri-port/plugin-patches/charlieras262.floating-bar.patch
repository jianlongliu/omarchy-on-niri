   }
 
@@ -1135,6 +1130,13 @@ Item {
     WlrLayershell.namespace: "omarchy-bar"
     WlrLayershell.layer: WlrLayer.Top
 
+    // niri port: hand niri the bar's own rounded rect as the blur region, so the
