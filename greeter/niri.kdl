// Greeter compositor config. Copied to /etc/greetd/omarchy-greeter/niri.kdl by
// install.sh; niri runs it as the `greeter` user on the greeter VT.
//
// GREETER_* values are the greeter's whole configuration surface: login user,
// session command, wallpaper, avatar. They are read by shell.qml through
// Quickshell.env().
hotkey-overlay {
    skip-at-startup
}

environment {
    XDG_SESSION_TYPE "wayland"
    // The greeter's HOME: sync.sh puts the theme's colors.toml / shell.toml in
    // $HOME/.local/state/omarchy/current/theme so the login screen matches the
    // desktop palette.
    // Load-bearing: the greeter user's passwd home is "/", so HOME must be set
    // here or nothing can find the synced theme.
    HOME "/var/lib/greeter"
    GREETER_USER "jianlongliu"
    GREETER_SESSION "niri-session"
    // Wallpaper and avatar come from the selected account's synced artwork
    // (omarchy-greeter-sync); GREETER_ACCOUNTS_DIR moves that directory.
    GREETER_CORNER_RADIUS "10"
}

gestures {
    hot-corners {
        off
    }
}

layout {
    background-color "#000000"
}

input {
    keyboard {
        xkb
        numlock
    }
    touchpad {
        tap
        dwtp
        natural-scroll
    }
    mouse
    trackpoint {
        accel-speed 0.5
    }
}

cursor {
    xcursor-theme "Bibata-Modern-Amber"
    xcursor-size 30
    hide-when-typing
}

output "eDP-1" {
    // 2560x1600@60, the panel's native mode. Never a `mode` line: Omarchy's
    // monitor panel sends WxH@Hz which niri rejects.
    modeline 268.5 2560 2608 2640 2720 1600 1603 1609 1646 "+hsync" "-vsync"
    scale 1.5
    position x=0 y=0
    variable-refresh-rate
}

// Quickshell is the whole session here: when it exits (login handed to
// greetd), take niri with it so greetd sees the greeter process tree end and
// starts the user's session.
//
// Output goes to $HOME/greeter.log rather than the VT console: once the greeter
// owns the tty, its stdout is only visible on that screen, which makes a failed
// login impossible to diagnose from a session. $HOME is /var/lib/greeter here,
// owned by the greeter user, so the redirect is writable.
spawn-sh-at-startup "log=\"$HOME/greeter.log\"; printf '\n== %s greeter start ==\n' \"$(date -Is)\" >>\"$log\"; exec >>\"$log\" 2>&1; quickshell -p /etc/greetd/omarchy-greeter; niri msg action quit --skip-confirmation"
